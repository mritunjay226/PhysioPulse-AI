{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "physiopulse/server.py",
      "functions": {
        "physiopulse/server.py": {
          "excludeFiles": "{web_app/**,ppt/**,scripts/**,models/**,*.task,*.pptx,*.json,*.md,venv/**}"
        }
      }
    },
    "web_app": {
      "root": "web_app",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "APP_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web_app"
      }
    }
  ]
}
